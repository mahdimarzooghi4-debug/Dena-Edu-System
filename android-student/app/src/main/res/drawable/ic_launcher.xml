<?xml version="1.0" encoding="utf-8"?>
<!-- Official Dena wordmark, taken directly from public/dena-app-logo.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5B4CE2" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="9dp" android:right="9dp" android:top="26dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/dena_official_logo"
        android:gravity="center" android:width="76dp" android:height="44dp" />
</layer-list>
