# Copy to app.env. Never commit the completed file or real secrets.
NODE_ENV=production
BETTER_AUTH_URL=https://dena.example.ir
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://dena_app:URL_ENCODED_PASSWORD@db:5432/dena?sslmode=verify-full
DATABASE_SSL_CA=/run/secrets/postgres-ca.crt

# External integrations remain disabled until their real contracts and secrets are configured.
DENA_SMS_ENABLED=0
DENA_MEDIA_ENABLED=0
DENA_INGEST_ENABLED=0
DENA_MEDIA_PROCESSOR_ENABLED=0
DENA_MEDIA_ATTESTATION_ENABLED=0
DENA_MEDIA_CLEANUP_ENABLED=0
DENA_SUPPORT_ATTACHMENTS_ENABLED=0
DENA_SUPPORT_ATTACHMENT_SCANNER_ENABLED=0
DENA_LIVEKIT_ENABLED=0
DENA_LIVEKIT_ROOM_CONTROL_ENABLED=0
DENA_MULTIPART_PLANNING_ENABLED=0

# Set these only when self-hosted LiveKit is provisioned and verified.
LIVEKIT_URL=wss://calls.example.ir
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DENA_LIVEKIT_QUOTA_WORKER_TOKEN=
DENA_LIVEKIT_QUOTA_SWEEP_URL=https://dena.example.ir/api/internal/livekit-quota/sweep
