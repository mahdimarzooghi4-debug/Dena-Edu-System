# Development examples only; never commit real secrets.
# A dedicated local PostgreSQL database/user is required for DB-backed endpoints.
# Full-release static preflight requires DATABASE_URL ?sslmode=verify-full,
# a non-loopback hostname and NODE_ENV=production. Verify the real CA,
# certificate hostname and TLS negotiation independently before deployment.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Phone OTP is OFF unless explicitly enabled after the provider is configured.
# The vendor adapter must expose POST JSON {phoneNumber, code, purpose}.
DENA_SMS_ENABLED=0
DENA_SMS_GATEWAY_URL=
DENA_SMS_GATEWAY_TOKEN=

# PRIVATE MP4 origin (off until real private storage and verified ingest exist).
# Only HTTPS in real environments. Never set DENA_DB_INTEGRATION in production.
DENA_MEDIA_ENABLED=0
DENA_PRIVATE_MEDIA_ORIGIN_URL=
DENA_PRIVATE_MEDIA_ORIGIN_TOKEN=

# BOUNDED ingest PILOT only (defaults OFF). Must point at PRIVATE media origin.
# Never reuse the origin Bearer token as the independent worker callback token.
DENA_INGEST_ENABLED=0
DENA_MEDIA_PROCESSOR_ENABLED=0
DENA_MEDIA_PROCESSOR_TOKEN=

# Separately signed scan/transcode reports; OFF until an isolated scanner,
# private metadata adapter and secret management are reviewed. The local
# integration mock signs reports for testing, not evidence of real scanning.
DENA_MEDIA_ATTESTATION_ENABLED=0
DENA_MEDIA_ATTESTATION_KEY_ID=
DENA_MEDIA_ATTESTATION_HMAC_KEY=

# Quarantine garbage collector: internal operator/cron endpoint, disabled
# by default. Use separate secret, private DELETE adapter and monitoring.
DENA_MEDIA_CLEANUP_ENABLED=0
DENA_MEDIA_CLEANUP_TOKEN=

# Multipart metadata-only DRY RUN. Enables inert planning endpoint but never
# issues signed parts, creates storage uploads or accepts/serves large files.
DENA_MULTIPART_PLANNING_ENABLED=0
